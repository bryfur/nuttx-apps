#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config SYSTEM_SHA256SUM
	tristate "sha256sum: SHA-256 of files"
	default n
	depends on CRYPTO
	---help---
		The SHA-256 of files (and -c, a list checked), through /dev/crypto
		(CRYPTO_CRYPTODEV: on the RP2350 its SHA-256 accelerator) or in
		software (crypto/sha2.c); -t tests it (NIST examples, random
		messages against software, two tasks at once), -b measures it.

if SYSTEM_SHA256SUM

config SYSTEM_SHA256SUM_PROGNAME
	string "Program name"
	default "sha256sum"

config SYSTEM_SHA256SUM_PRIORITY
	int "Task priority"
	default 100

config SYSTEM_SHA256SUM_STACKSIZE
	int "Stack size"
	default 4096

endif
