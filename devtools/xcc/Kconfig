#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config DEVTOOLS_XCC
	tristate "xcc: a small C compiler (C to WebAssembly, C to Thumb-2)"
	default n
	depends on ALLOW_MIT_COMPONENTS
	depends on m || ARCH_SIM
	---help---
		tyfkda's xcc (https://github.com/tyfkda/xcc, MIT), a small
		C compiler written in C, on the board: wcc compiles C to a
		WebAssembly (WASI) program for the WebAssembly runtime.  Its
		headers and C library (WASI) are DEVTOOLS_XCC_ROOT/include
		and /lib.  A loadable module (/mnt/sd0/bin): no memory taken
		while it is not running (in the simulator it is built in).
		docs/xcc.md.

if DEVTOOLS_XCC

config DEVTOOLS_XCC_NATIVE
	bool "xcc: C to native NuttX modules (Thumb-2)"
	default y
	---help---
		The xcc program: C to loadable modules for this board's
		Cortex-M33 (Thumb-2, hard float), with xcc's ARM32 backend,
		assembler and linker; the NuttX headers the firmware was built
		with (DEVTOOLS_XCC_ROOT/arm).  What a module calls in the
		firmware must be in its symbol table: nuttx/symtab.list adds
		the C library's and the run-time ABI's functions to it.
		Native modules are not sandboxed: a bad pointer can bring the
		system down (docs/xcc.md).

config DEVTOOLS_XCC_ROOT
	string "Headers and libraries"
	default "/mnt/sd0/xcc"
	---help---
		Where include/ and lib/ are ($XCC_ROOT overrides it).

config DEVTOOLS_XCC_PRIORITY
	int "Priority"
	default 100

config DEVTOOLS_XCC_STACKSIZE
	int "Stack size"
	default 32768
	---help---
		The parser and the code generator recurse along the
		expressions and statements of the program compiled.

endif
