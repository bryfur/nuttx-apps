# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config GAMES_TRIGAMES
	tristate "TRI's other games (Skyrocks, Sprite bench, FM synth)"
	default n
	depends on GRAPHICS_FPCGAME && FPCGAME_TRI
	---help---
		The TRI console's other games, as they are, on the FPC game
		SDK's TRI runtime: skyrocks (an asteroid field), spritebench
		(hundreds of sprites, the frame time), fmsynth (the FM engine
		played from the pad).
