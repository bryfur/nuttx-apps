#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config GAMES_THUNDERBOLT
	tristate "Thunderbolt (TRI's side-scrolling shooter)"
	default n
	depends on GRAPHICS_FPCGAME && FPCGAME_TRI
	---help---
		Thunderbolt, the WW2 horizontal shooter from the TRI console
		(TRI's firmware/games/thunderbolt), running on the FPC game
		SDK's TRI runtime: full screen at 1280 x 720 (424 x 240 at
		three times), arrows to fly, Z guns, X cannon, C rockets, V or
		Space bombs, Escape to leave.
