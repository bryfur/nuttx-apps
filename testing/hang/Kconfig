#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config TESTING_HANG
	tristate "hang: hang the system on purpose (watchdog test)"
	default n
	---help---
		Spins in one of the ways that hang a system: with this CPU's
		interrupts off, inside a critical section, with pre-emption off,
		or at the highest priority on every CPU; forever, or for some
		seconds.  For testing the watchdog (it must reset the chip, and
		the next boot must say "watchdog"): docs/hardware-accel.md.
		Only for test builds: anyone who can run it can hang the board.

if TESTING_HANG

config TESTING_HANG_PROGNAME
	string "Program name"
	default "hang"

config TESTING_HANG_PRIORITY
	int "Task priority"
	default 100

config TESTING_HANG_STACKSIZE
	int "Stack size"
	default 2048

endif
