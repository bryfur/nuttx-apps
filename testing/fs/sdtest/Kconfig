#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config TESTING_SDTEST
	tristate "sdtest: storage throughput and integrity"
	default n
	---help---
		File checksums (CRC-32), read and write throughput into an SRAM
		or a PSRAM buffer, and a write/read-back stress of files of
		random sizes written and read in random pieces at random
		offsets, from unaligned buffers too (docs/storage.md).

if TESTING_SDTEST

config TESTING_SDTEST_PROGNAME
	string "Program name"
	default "sdtest"

config TESTING_SDTEST_PRIORITY
	int "Task priority"
	default 100

config TESTING_SDTEST_STACKSIZE
	int "Stack size"
	default 8192
	---help---
		The file system and the card's driver run on this stack too.

endif
