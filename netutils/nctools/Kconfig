#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config NETUTILS_NCTOOLS
	tristate "netcop tools: wifi, ifconfig, ssh, curl, wget, nc, ntpdate, bt"
	default n
	depends on NETUTILS_NETCOP
	---help---
		Commands for the network coprocessor (fpc/docs/netcop.md): wifi
		and ifconfig (status, scan, connect), bt (BLE devices), ssh
		(sessions offloaded to the coprocessor), curl and wget (HTTP and
		HTTPS, TLS offloaded), nc, host, ntpdate.  As loadable modules
		(m), they take no memory until they run.

if NETUTILS_NCTOOLS

config NCTOOLS_PRIORITY
	int "Task priority"
	default 100

config NCTOOLS_STACKSIZE
	int "Stack size"
	default 4096

endif
