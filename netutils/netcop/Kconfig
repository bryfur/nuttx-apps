#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config NETUTILS_NETCOP
	bool "netcop: the network coprocessor's daemon (netcopd)"
	default n
	depends on NET_USRSOCK && NET_USRSOCK_DEVICE
	---help---
		netcopd makes ordinary sockets work through the fpc's network
		coprocessor (a XIAO ESP32-C6 or -S3 on SPI0 or a UART,
		fpc/docs/netcop.md):
		WiFi, TLS and SSH done by the coprocessor, its BLE keyboards,
		mice and game pads into /dev/vinput (fpc/drivers/netcop).  The
		library (netutils/netcop.h) gives programs TLS on a socket, SSH
		sessions and the control socket for WiFi, BLE and the rest.

if NETUTILS_NETCOP

config NETCOP_DEVPATH
	string "The coprocessor's UART, or its SPI link"
	default "/dev/netcop" if FPC_NETCOP_SPI
	default "/dev/ttyS0"

config NETCOP_BAUD
	int "Speed asked for once the link is up (0: stay at the first)"
	default 20000000 if FPC_NETCOP_SPI
	default 3000000
	---help---
		UART: the baud rate (the link starts at 115200).  SPI
		(FPC_NETCOP_SPI): the clock in Hz (the link starts at 10 MHz;
		the coprocessor takes up to 40 MHz).  A speed that fails soon
		after the switch is halved at the next try.

config NETCOP_FLOWCONTROL
	bool "RTS/CTS flow control on the UART"
	default y
	depends on !FPC_NETCOP_SPI

config NETCOP_WINDOW
	int "Receive window per socket (bytes, in the heap)"
	default 8192

config NETCOP_NTP_SERVERS
	string "NTP servers (separated by ;)"
	default "pool.ntp.org"
	depends on NETUTILS_NTPCLIENT
	---help---
		NuttX's NTP client is started with these once WiFi is up; the
		port is CONFIG_NETUTILS_NTPCLIENT_PORTNO.

config NETCOP_HOSTNAME
	string "Name given in HELLO"
	default "fpc"

config NETCOP_CLOCK_VALID
	bool "The clock is right at boot"
	default n
	---help---
		The coprocessor gets the time (TIME_SET, its fallback) at link
		up only if the clock is known to be right (a battery-backed
		RTC); otherwise once NTP has set it.

config NETCOP_DEBUG
	bool "Log every usrsock request"
	default n

config NETCOP_PRIORITY
	int "netcopd priority"
	default 110

config NETCOP_STACKSIZE
	int "netcopd stack size"
	default 3072

endif # NETUTILS_NETCOP
