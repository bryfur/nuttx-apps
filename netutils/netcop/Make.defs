ifneq ($(CONFIG_NETUTILS_NETCOP),)
CONFIGURED_APPS += $(APPDIR)/netutils/netcop

# The protocol's headers (fpc/netcop/include), for netutils/netcop.h

CFLAGS += ${INCDIR_PREFIX}$(APPDIR)/../netcop/include
endif
