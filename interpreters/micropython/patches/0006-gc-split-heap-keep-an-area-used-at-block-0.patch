gc: an added area whose only live block is its first is kept

With MICROPY_GC_SPLIT_HEAP_AUTO the sweep frees an added area when
nothing in it is used, which it tells by last_used_block == 0: but that
is also what an area whose only live object starts at block 0 has, and
that area was freed with the object in it.  A flag says whether a block
was kept.  (A tail is never at block 0, so a kept head is the case.)

--- a/py/gc.c
+++ b/py/gc.c
@@ -714,6 +714,9 @@
 
     for (mp_state_mem_area_t *area = &MP_STATE_MEM(area); area != NULL; area = NEXT_AREA(area)) {
         size_t last_used_block = 0;
+        #if MICROPY_GC_SPLIT_HEAP_AUTO
+        bool area_used = false; // last_used_block is 0 also when block 0 is the one used
+        #endif
         assert(area->gc_last_used_block <= area->gc_alloc_table_byte_len * BLOCKS_PER_ATB);
 
         for (size_t block = 0; block <= area->gc_last_used_block; block++) {
@@ -743,6 +746,9 @@
                     ATB_MARK_TO_HEAD(area, block);
                     free_tail = 0;
                     last_used_block = block;
+                    #if MICROPY_GC_SPLIT_HEAP_AUTO
+                    area_used = true;
+                    #endif
                     break;
             }
         }
@@ -751,7 +757,7 @@
 
         #if MICROPY_GC_SPLIT_HEAP_AUTO
         // Free any empty area, aside from the first one
-        if (last_used_block == 0 && prev_area != NULL) {
+        if (!area_used && prev_area != NULL) {
             DEBUG_printf("gc_sweep_free_blocks free empty area %p\n", area);
             NEXT_AREA(prev_area) = NEXT_AREA(area);
             MP_PLAT_FREE_HEAP(area);
