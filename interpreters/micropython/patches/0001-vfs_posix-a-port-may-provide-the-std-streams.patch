vfs_posix: a port may provide sys.stdin, stdout and stderr itself

With MICROPY_VFS_POSIX_STDIO 0 the VFS leaves them to the port (NuttX:
shared/runtime/sys_stdio_mphal.c, so that reading stdin goes through
mp_hal_stdin_rx_chr(), which watches for Ctrl-C).

diff --git a/extmod/vfs_posix_file.c b/extmod/vfs_posix_file.c
index 5fe330d..34d69b4 100644
--- a/extmod/vfs_posix_file.c
+++ b/extmod/vfs_posix_file.c
@@ -292,7 +292,13 @@ static const mp_stream_p_t vfs_posix_textio_stream_p = {
     .is_text = true,
 };
 
-#if MICROPY_PY_SYS_STDIO_BUFFER
+// A port may provide sys.stdin, stdout and stderr itself (e.g.
+// shared/runtime/sys_stdio_mphal.c, through its mp_hal functions).
+#ifndef MICROPY_VFS_POSIX_STDIO
+#define MICROPY_VFS_POSIX_STDIO (1)
+#endif
+
+#if MICROPY_PY_SYS_STDIO_BUFFER && MICROPY_VFS_POSIX_STDIO
 
 mp_obj_vfs_posix_file_t mp_sys_stdin_buffer_obj = {{&mp_type_vfs_posix_fileio}, STDIN_FILENO};
 mp_obj_vfs_posix_file_t mp_sys_stdout_buffer_obj = {{&mp_type_vfs_posix_fileio}, STDOUT_FILENO};
@@ -347,8 +353,10 @@ MP_DEFINE_CONST_OBJ_TYPE(
     locals_dict, &vfs_posix_rawfile_locals_dict
     );
 
+#if MICROPY_VFS_POSIX_STDIO
 mp_obj_vfs_posix_file_t mp_sys_stdin_obj = {{&mp_type_vfs_posix_textio}, STDIN_FILENO};
 mp_obj_vfs_posix_file_t mp_sys_stdout_obj = {{&mp_type_vfs_posix_textio}, STDOUT_FILENO};
 mp_obj_vfs_posix_file_t mp_sys_stderr_obj = {{&mp_type_vfs_posix_textio}, STDERR_FILENO};
+#endif
 
 #endif // MICROPY_VFS_POSIX
