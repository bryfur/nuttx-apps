Loading without the fast interpreter's translation (fpcwasm's JIT)

wasm_loader_validate_only: the loader's first pass over a function
validates it; the second, which writes the fast interpreter's
translation, is left out.  The JIT compiles from the bytecode: its
modules need neither the time nor the memory of the translation.  Calling
such a function through the interpreter is an exception.

diff -ru a/core/iwasm/interpreter/wasm_interp_fast.c b/core/iwasm/interpreter/wasm_interp_fast.c
--- a/core/iwasm/interpreter/wasm_interp_fast.c	2026-10-06 19:57:48.565965576 +0000
+++ b/core/iwasm/interpreter/wasm_interp_fast.c	2026-10-06 19:57:48.576332861 +0000
@@ -7934,6 +7934,12 @@
         return;
     }
 
+    if (!function->is_import_func && !function->u.func->code_compiled) {
+        /* Loaded with wasm_loader_validate_only: nothing to interpret */
+        wasm_set_exception(module_inst, "the function was not translated");
+        return;
+    }
+
     if (!(frame =
               ALLOC_FRAME(exec_env, frame_size, (WASMInterpFrame *)prev_frame)))
         return;
diff -ru a/core/iwasm/interpreter/wasm_loader.c b/core/iwasm/interpreter/wasm_loader.c
--- a/core/iwasm/interpreter/wasm_loader.c	2026-10-06 19:57:48.565262673 +0000
+++ b/core/iwasm/interpreter/wasm_loader.c	2026-10-06 19:57:48.574332847 +0000
@@ -11602,6 +11602,11 @@
 
 #endif /* end of WASM_ENABLE_FAST_INTERP != 0 */
 
+/* Set by an embedder that compiles the code itself (fpcwasm's JIT): the
+   fast interpreter's own translation is left out (its first pass validates
+   the code; the second, which writes the translation, is not done) */
+bool wasm_loader_validate_only = false;
+
 static bool
 wasm_loader_prepare_bytecode(WASMModule *module, WASMFunction *func,
                              uint32 cur_func_idx, char *error_buf,
@@ -16853,6 +16858,17 @@
     }
 
 #if WASM_ENABLE_FAST_INTERP != 0
+    if (loader_ctx->p_code_compiled == NULL && wasm_loader_validate_only) {
+        /* Validated: no translation, nothing the interpreter could run */
+        func->code_compiled = NULL;
+        func->code_compiled_size = 0;
+        func->const_cell_num = 0;
+        func->max_stack_cell_num = 0;
+        func->max_block_num = loader_ctx->max_csp_num;
+        return_value = true;
+        goto fail;
+    }
+
     if (loader_ctx->p_code_compiled == NULL)
         goto re_scan;
 
diff -ru a/core/iwasm/interpreter/wasm_loader.h b/core/iwasm/interpreter/wasm_loader.h
--- a/core/iwasm/interpreter/wasm_loader.h	2026-10-06 19:57:48.565807379 +0000
+++ b/core/iwasm/interpreter/wasm_loader.h	2026-10-06 19:57:48.576299897 +0000
@@ -51,6 +51,10 @@
 void
 wasm_loader_unload(WASMModule *module);
 
+/* Load the next modules without the fast interpreter's translation (an
+   embedder that runs their code itself) */
+extern bool wasm_loader_validate_only;
+
 /**
  * Find address of related else opcode and end opcode of opcode block/loop/if
  * according to the start address of opcode.
