#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menuconfig GRAPHICS_FPCGL
	bool "fpcgl: an OpenGL 1.x subset on the FPC's 3D GPU"
	default n
	depends on FPC_GPU
	---help---
		The GL calls a fixed-function renderer uses (immediate mode,
		the matrix stacks, the depth test, culling, shading, textures)
		on the FPC's 3D GPU (docs/gpu3d.md: the FPGA's second
		bitstream, switched to while a program uses it): the CPU
		transforms, clips and sets up the triangles, the GPU draws them
		with a depth buffer and perspective-correct textures.

if GRAPHICS_FPCGL

config FPCGL_DEMO
	tristate "fgldemo: a textured, shaded scene"
	default n

endif
