#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menuconfig GRAPHICS_FPCDESK
	bool "FPC desktop (a composited desktop shell for NX)"
	default n
	depends on NX && NX_RAMBACKED
	select NX_COMPOSITOR if NX_ACCEL
	select PSEUDOTERM
	---help---
		A modern desktop for the FPC: a top bar with the clock, a dock,
		windows with title bars, traffic-light buttons, round corners
		and soft shadows, all drawn and composited by the GPU through
		the NX server (CONFIG_NX_COMPOSITOR).  The terminal runs NSH
		on pseudo-terminals, in tabs.  A dark and a light theme.  The
		System Log reads the RAM log (CONFIG_RAMLOG_SYSLOG).

if GRAPHICS_FPCDESK

config FPCDESK_PROGNAME
	string "Program name"
	default "desk"

config FPCDESK_PRIORITY
	int "Priority"
	default 100

config FPCDESK_STACKSIZE
	int "Stack size"
	default 8192

config FPCDESK_TERM_STACKSIZE
	int "Terminal (NSH) stack size"
	default 8192

config FPCDESK_TERM_PRIORITY
	int "Terminal (NSH) priority"
	default 100

config FPCDESK_TERM_SCROLLBACK
	int "Terminal scrollback (lines a tab)"
	default 500
	---help---
		The most lines a terminal tab keeps after they scroll off the
		top.  They are allocated as they come, trimmed of trailing
		blanks.

config FPCDESK_LISTENER_STACKSIZE
	int "NX event listener stack size"
	default 4096

config FPCDESK_SYSMON_DISK
	string "System Monitor: disk mount point"
	default ""
	---help---
		A mount point whose use the System Monitor shows (statfs()),
		e.g. /mnt/sd0.  Empty for none.  A disk that is not mounted is
		shown as such.

config FPCDESK_SYSMON_DISKNAME
	string "System Monitor: disk name"
	default "Disk"
	---help---
		The name the System Monitor gives the disk, e.g. microSD.

config FPCDESK_WALLPAPER
	bool "Wallpaper"
	default n
	---help---
		A wallpaper drawn by the GPU (gradients and soft glows, three
		to choose from in Settings).  It is a surface the size of the
		display: a quarter of the GPU's memory at 1280 x 800.  Without
		it the background is black.

config FPCDESK_WIDGETS
	bool "Widgets: the widget kit's gallery"
	default y
	---help---
		An application that shows every control of the widget kit
		(desk_kit.h, docs/uikit.md) in each of its states, with lists,
		dialogs, menus and tooltips: the kit's demonstration and test.

config FPCDESK_PREFS
	string "Settings file"
	default ""
	---help---
		Where the desktop keeps the settings it remembers across boots
		(the display mode, the wallpaper, the theme, the dock, ...).
		Empty: .fpcdesk in the home directory ($HOME, else
		CONFIG_LIBC_HOMEDIR).

if GAMES_NXDOOM_DESKTOP

config FPCDESK_DOOM_PRIORITY
	int "Doom: priority"
	default 90
	---help---
		The game's task, below the desktop's so that the desktop stays
		quick to answer while it runs.

config FPCDESK_DOOM_STACKSIZE
	int "Doom: stack size"
	default 8192

config FPCDESK_DOOM_WADDIRS
	string "Doom: where else to look for the game's data"
	default ""
	---help---
		Directories, separated by spaces, where Doom's window looks for
		an IWAD (doom1.wad, doom.wad, doom2.wad, freedoom1.wad, ...)
		after the home directory ($HOME, else CONFIG_LIBC_HOMEDIR).
		Doom keeps its configuration and saved games in .doom/ beside
		the IWAD it found.

config FPCDESK_GAME_CPUSCALE
	bool "Games: scale frames on the CPU"
	default n
	---help---
		A game's frames are scaled to its window across by the CPU (for
		free: a palette lookup gives the pixel twice) and down by the
		GPU (each row PUT once into a hidden window, then COPYed as many
		times as the scale).  This scales down on the CPU too and PUTs
		all of it: twice the bytes on the link at 2x.  For comparison.

endif

config FPCDESK_SOUND
	bool "Sound: system sounds, the volume control, Settings' Sound page"
	default y
	depends on FPC_AUDIO
	---help---
		With the FPC's audio mixer (/dev/mixer): a speaker in the top
		bar with a popover (the volume, mute, what is playing, each
		program's level), a Sound page in Settings (the volume, mute,
		the alert volume, interface sounds, the applications' levels),
		and short system sounds (a window opening, closing, an alert, a
		notification).  The volume keys show the popover.

config FPCDESK_MUSIC
	bool "Music player"
	default y
	depends on FPCDESK_SOUND
	---help---
		A Music application: plays the WAV files (and MP3 files with
		AUDIOUTILS_LIBMAD) of a folder, one after the other.

config FPCDESK_MUSIC_DIR
	string "Music: the folder"
	default ""
	depends on FPCDESK_MUSIC
	---help---
		Where the Music application looks for files.  Empty: the home
		directory ($HOME, else CONFIG_LIBC_HOMEDIR), and its Music
		folder if it has one.

config FPCDESK_BENCH
	bool "GPU Bench: benchmarks, meters and demonstrations of the GPU"
	default y
	depends on FPC_GPU && NX_COMPOSITOR
	---help---
		An application that measures the FPC's GPU (FILL, COPY, the
		kinds of BLEND, EXPAND, BC1), its link (PUT, READ), the
		compositor and the commands a second, by the GPU's own clock
		where it has one (v6 STATS); graphs of how busy the GPU and
		its SDRAM are and of the link, from /proc/gpu; and
		demonstrations of what it draws.  It calls the board's GPU
		driver (a flat build).

config FPCDESK_CHESS
	bool "Chess"
	default y
	---help---
		Chess against the computer (six levels) or two players at one
		board, with its own engine in a thread of its own; and the
		chess command: the engine's move generator checked against the
		standard positions (chess perft), its speed (chess bench), its
		move in a position (chess go).

if FPCDESK_CHESS

config FPCDESK_CHESS_TT_KB
	int "Chess: the engine's transposition table (KB)"
	default 512
	---help---
		The positions the engine remembers while it searches, 12
		bytes each, from the heap (the PSRAM on the board) while the
		Chess window is open.  Halved until it fits if memory is short.

config FPCDESK_CHESS_PRIORITY
	int "Chess: the engine's priority"
	default 90
	---help---
		The engine's thread, below the desktop's so that the desktop
		stays quick to answer while it thinks.

config FPCDESK_CHESS_STACKSIZE
	int "Chess: the engine's stack, besides its search"
	default 12288
	---help---
		The engine's thread keeps its search (about 14 KB) on its
		stack, so that on the board it is in the SRAM; this is the
		stack it has besides, for its recursion.

endif

config FPCDESK_DESKCTL
	bool "deskctl: scripted input and screenshots"
	default y
	---help---
		deskctl m X Y [BUTTONS]  move the pointer (and press buttons)
		deskctl c X Y [N]        click (N times)
		deskctl k TEXT           type
		deskctl shot FILE        screenshot (simulator)
		deskctl freeze [SECONDS] stop the clock, the blinking, the games
		deskctl dock APP [r]     click an application's dock icon
		deskctl wins             the windows, top first
		For testing the desktop without a mouse and keyboard.

config FPCDESK_SHEET_CMD
	bool "sheet: the Spreadsheet's engine from NSH"
	default y
	---help---
		sheet --selftest [DIR]  the formula engine's tests
		sheet --bench [ROWS]    a big sheet's memory and recalculation
		sheet FILE              a .csv or .sheet file's values

endif
