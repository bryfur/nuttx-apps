#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config GRAPHICS_FPCWASM
	tristate "WebAssembly apps (wasm: WAMR and the fpc API)"
	default n
	depends on INTERPRETERS_WAMR && GRAPHICS_FPCGAME
	---help---
		The wasm command: sandboxed WebAssembly apps and games on WAMR
		(interpreted, or compiled ahead of time by wamrc on a PC), with
		WASI and the FPC's own API (sdk/fpc_wasm.h: a full-screen game,
		images, sprites, layers, text, input, sound) on the game SDK.
		docs/wasm.md.

if GRAPHICS_FPCWASM

config FPCWASM_APPDIR
	string "Where apps are installed"
	default "/mnt/sd0/apps"
	---help---
		A directory a app: NAME/app.wasm (and app.aot), manifest,
		icon.bmp, its data.  The desktop's launcher lists them.

config FPCWASM_STACKSIZE
	int "The wasm command's stack"
	default 16384
	---help---
		The task's (native) stack: the interpreter's frames, the game
		SDK's, and AOT code's frames (a wasm call each).

config FPCWASM_ROCKSN
	bool "rocksn: the Rocks example as a native program"
	default n
	---help---
		sdk/examples/rocks/rocks.c built as a native NuttX program on
		sdk/fpc_native.c (the fpc API straight onto the game SDK): the
		same game as the WebAssembly app, to compare their frame times
		(rocksn -b N, wasm run rocks -b N).

endif
