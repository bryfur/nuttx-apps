#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_NXDRAG
	tristate "NX window drag benchmark"
	default n
	depends on NX && NX_RAMBACKED
	---help---
		Opens a RAM-backed framed window (as twm4nx does) on the running
		NX server and moves it step by step, waiting for the server to
		finish each move: the time per step is what a window drag costs.

if EXAMPLES_NXDRAG

config EXAMPLES_NXDRAG_PROGNAME
	string "Program name"
	default "nxdrag"

config EXAMPLES_NXDRAG_PRIORITY
	int "Task priority"
	default 100

config EXAMPLES_NXDRAG_STACKSIZE
	int "Stack size"
	default DEFAULT_TASK_STACKSIZE

endif
